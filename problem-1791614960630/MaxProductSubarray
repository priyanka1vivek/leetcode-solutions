1 class Solution {
2 public:
3    int maxProduct(vector<int>& nums) {
4        int n = nums.size();
5        int minend = nums[0];
6        int maxend = nums[0];
7        int res = nums[0];
8
9        for(int i = 1;i < n;i++){
10            int v1 = nums[i];
11            int v2 = minend * nums[i];
12            int v3 = maxend * nums[i];
13            maxend = max({v1,v2,v3});
