class Solution {
  public:
    int minSubarraySum(vector<int> &arr) {
        // code here
        int n = arr.size();
        int best_ending = arr[0];
        int ans = arr[0];
        
        for(int i = 1; i < n; i++){
            int v1 = best_ending + arr[i];
            int v2 = arr[i];
            
            best_ending = min(v1,v2);
            ans = min(ans, best_ending);
        }
        return ans;
    }
};
